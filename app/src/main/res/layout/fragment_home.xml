<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".Home.HomeFragment">

    <!-- 🔷 BACKGROUND HEADER WAVE -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="@android:color/white" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp"
        android:text="Nisa PCR 👋"
        android:textColor="@android:color/black"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Pilih menu pertemuan"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMenu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btnLogout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- BUTTON PERTEMUAN 2 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToSecond"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#F1C40F"
                    android:text="📖 Pertemuan 2"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:cornerRadius="14dp" />

                <!-- BUTTON PERTEMUAN 3 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToThird"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#E67E22"
                    android:text="🎨 Pertemuan 3"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:cornerRadius="14dp" />

                <!-- BUTTON PERTEMUAN 4 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToFourth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#6C5CE7"
                    android:text="📚 Pertemuan 4"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:cornerRadius="14dp" />

                <!-- BUTTON PERTEMUAN 5 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToFifth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#00B894"
                    android:text="🚀 Pertemuan 5"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:cornerRadius="14dp" />

                <!-- BUTTON PERTEMUAN 7 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToSeventh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#0984E3"
                    android:text="🛠️ Pertemuan 7"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:cornerRadius="14dp" />

                <!-- BUTTON PERTEMUAN 9 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToNinth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#2D3436"
                    android:text="📱 Pertemuan 9"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:cornerRadius="14dp" />

                <!-- BUTTON PERTEMUAN 10 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToTenth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#FF5722"
                    android:text="📑 Pertemuan 10"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:cornerRadius="14dp" />

            </LinearLayout>
        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

    <!-- 🔷 LOGOUT BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:backgroundTint="#D63031"
        android:text="Logout"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>